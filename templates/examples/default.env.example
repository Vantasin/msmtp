# Copy this file to accounts/default.env and replace the placeholder values.
#
# Create more account files under `accounts/` when you want more than one
# mailing address.
#
# Choose exactly one secret method:
# - keychain
# - gpg
# - password_file
# - command

MSMTP_ACCOUNT_NAME=default
MSMTP_HOST=smtp.example.com
MSMTP_PORT=587
MSMTP_FROM=user@example.com
MSMTP_USER=user@example.com

MSMTP_AUTH=on
MSMTP_TLS=on
MSMTP_TLS_STARTTLS=on
MSMTP_TLS_CERTCHECK=on
# Set this to true on only one account file or pass DEFAULT_ACCOUNT=<name>
# when generating or installing.
MSMTP_SET_DEFAULT=true

# Optional:
MSMTP_LOGFILE=
MSMTP_TLS_TRUST_FILE=
MSMTP_TLS_FINGERPRINT=

MSMTP_SECRET_METHOD=keychain

# macOS Keychain mode
MSMTP_KEYCHAIN_SERVICE=smtp.example.com
MSMTP_KEYCHAIN_ACCOUNT=user@example.com

# Linux GPG mode
MSMTP_GPG_FILE=

# Root-owned password file mode
MSMTP_PASSWORD_FILE=

# Raw passwordeval mode
MSMTP_PASSWORDEVAL_COMMAND=
